FROM node:22-bookworm-slim

# Install Python, git, curl, unzip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git curl unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone fresh (build arg allows testing a specific branch/ref)
ARG REPO=https://github.com/rajan-chari/fellow-agents.git
ARG REF=main
RUN git clone --branch $REF --single-branch $REPO /app

# Run the E2E test script
COPY test-e2e.sh /app/test-e2e.sh
RUN chmod +x /app/test-e2e.sh
CMD ["/app/test-e2e.sh"]
